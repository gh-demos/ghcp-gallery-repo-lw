'use client';

import { useMemo, useState } from 'react';
import { AdminGalleryToolbar, GalleryTable, Hero, SectionContainer, SectionTitle, StatsGrid } from '@/components/ui';
import { mockGalleries } from '@/lib/mock-gallery-data';
import { dashboardStats } from '@/lib/mock-admin-data';

export default function AdminGalleriesPage() {
  const [searchQuery, setSearchQuery] = useState('');
  const [statusFilter, setStatusFilter] = useState('all');
  const [typeFilter, setTypeFilter] = useState('all');

  const filteredGalleries = useMemo(() => {
    return mockGalleries.filter((gallery) => {
      const query = searchQuery.trim().toLowerCase();
      const matchesSearch =
        query.length === 0 ||
        gallery.name.toLowerCase().includes(query) ||
        gallery.description.toLowerCase().includes(query) ||
        gallery.tags.some((tag) => tag.toLowerCase().includes(query));

      const matchesStatus = statusFilter === 'all' || gallery.status === statusFilter;
      const matchesType = typeFilter === 'all' || gallery.type === typeFilter;

      return matchesSearch && matchesStatus && matchesType;
    });
  }, [searchQuery, statusFilter, typeFilter]);

  return (
    <div className="page-gradient">
      <Hero
        title="Admin Gallery Management"
        description="Search, filter, and manage gallery visibility, publishing state, and upcoming client workflows."
      />

      <SectionContainer>
        <SectionTitle title="Gallery Performance" viewAllLink="/admin" className="mb-6" />
        <StatsGrid stats={dashboardStats} />

        <SectionTitle title="Gallery Controls" className="mt-10 mb-4" />
        <AdminGalleryToolbar
          searchQuery={searchQuery}
          statusFilter={statusFilter}
          typeFilter={typeFilter}
          onSearchChange={setSearchQuery}
          onStatusFilterChange={setStatusFilter}
          onTypeFilterChange={setTypeFilter}
          onClearFilters={() => {
            setSearchQuery('');
            setStatusFilter('all');
            setTypeFilter('all');
          }}
          createHref="/admin/galleries/new"
        />

        <SectionTitle title="Gallery List" className="mb-4" />
        <GalleryTable
          galleries={filteredGalleries}
          emptyMessage="No galleries match your current filters."
        />
      </SectionContainer>
    </div>
  );
}
